@inject NavigationManager NavManager

<aside class="sidebar">
    <div class="sidebar-logo">
        <div class="sidebar-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg>
        </div>
        <div>
            <div class="sidebar-logo-text">agiliz<span>.ia</span></div>
            <div class="sidebar-logo-sub">painel da equipe</div>
        </div>
    </div>
    
    <nav class="sidebar-nav">
        <button class="nav-item @(IsActive("") ? "active" : "")" @onclick='() => NavigateTo("")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="1" y="1" width="6" height="6" rx="1"/><rect x="9" y="1" width="6" height="6" rx="1"/>
                <rect x="1" y="9" width="6" height="6" rx="1"/><rect x="9" y="9" width="6" height="6" rx="1"/>
            </svg>
            Dashboard
        </button>

        @if (User.IsAdmin)
        {
        <button class="nav-item @(IsActive("telemetry") ? "active" : "")" @onclick='() => NavigateTo("telemetry")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 14h12M4 14V8m4 6V4m4 10v-6"></path>
            </svg>
            Telemetria
        </button>
        }

        <button class="nav-item @(IsActive("handoff") ? "active" : "")" @onclick='() => NavigateTo("handoff")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 4.5h10M3 8h7M3 11.5h5"></path>
                <circle cx="12" cy="11.5" r="2"></circle>
            </svg>
            Atendimentos
        </button>

        <button class="nav-item @(IsActive("integrations") ? "active" : "")" @onclick='() => NavigateTo("integrations")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="4" cy="4" r="2"></circle><circle cx="12" cy="4" r="2"></circle><circle cx="8" cy="12" r="2"></circle>
                <path d="M5.5 5.5L7 10.5M10.5 5.5L9 10.5M6 4h4"></path>
            </svg>
            Integrações
        </button>

        <button class="nav-item @(IsActive("plans") ? "active" : "")" @onclick='() => NavigateTo("plans")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="2" width="12" height="12" rx="2"></rect><path d="M5 6h6M5 9h6M5 12h3"></path>
            </svg>
            Planos
        </button>

        <button class="nav-item @(IsActive("quiz") ? "active" : "")" @onclick='() => NavigateTo("quiz")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="8" cy="8" r="6.5"></circle><path d="M6.2 6.2a1.9 1.9 0 1 1 2.6 1.8c-.5.2-.8.6-.8 1.1v.4M8 11.6v.1"></path>
            </svg>
            Quiz de venda
        </button>

        <button class="nav-item @(IsActive("proposals") ? "active" : "")" @onclick='() => NavigateTo("proposals")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 2h6l3 3v9H4z"></path><path d="M10 2v3h3M6 8h5M6 11h5"></path>
            </svg>
            Propostas
        </button>

        @if (User.IsAdmin)
        {
        <button class="nav-item @(IsActive("billing") ? "active" : "")" @onclick='() => NavigateTo("billing")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="3" width="12" height="10" rx="2" ry="2"></rect>
                <line x1="2" y1="7" x2="14" y2="7"></line>
                <line x1="5" y1="10" x2="8" y2="10"></line>
            </svg>
            Financeiro
        </button>
        }

        <button class="nav-item @(IsActive("email") ? "active" : "")" @onclick='() => NavigateTo("email")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 4l6 4 6-4M2 4v8h12V4H2z"></path>
            </svg>
            Disparar E-mail
        </button>

        <button class="nav-item @(IsActive("acessos") ? "active" : "")" @onclick='() => NavigateTo("acessos")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="6" cy="5.5" r="2.5"></circle><path d="M1.5 14c.6-2.6 2.3-4 4.5-4s3.9 1.4 4.5 4"></path><path d="M12.5 5.5v4M10.5 7.5h4"></path>
            </svg>
            Acessos
        </button>

        <button class="nav-item @(IsActive("create") || IsActive("edit") ? "active" : "")" @onclick='() => NavigateTo("create")'>
            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="8" cy="8" r="6.5"/><line x1="8" y1="5" x2="8" y2="11"/><line x1="5" y1="8" x2="11" y2="8"/>
            </svg>
            Novo Bot
        </button>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-user-avatar" aria-hidden="true">@Initial</div>
            <div class="sidebar-user-text">
                <div class="sidebar-user-name">@User.Name</div>
                <div class="sidebar-user-role">@User.RoleLabel</div>
            </div>
        </div>
        @if (User.Account is not null)
        {
            <div class="sidebar-user-links">
                <a href="/entrar/conta" target="_top">Minha conta</a>
                <a href="/entrar/sair" target="_top">Sair</a>
            </div>
        }
    </div>
</aside>

@implements IDisposable

@code {
    [CascadingParameter] public Agiliz.Wizard.Accounts.PainelUser User { get; set; } = new(null);

    private string Initial => string.IsNullOrWhiteSpace(User.Name) ? "?" : User.Name.Trim()[..1].ToUpperInvariant();

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private bool IsActive(string href)
    {
        var path = new Uri(NavManager.Uri).AbsolutePath.Trim('/');
        if (string.IsNullOrEmpty(href))
            return string.IsNullOrEmpty(path);
            
        return path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateTo(string href)
    {
        NavManager.NavigateTo($"/{href}");
    }
}
