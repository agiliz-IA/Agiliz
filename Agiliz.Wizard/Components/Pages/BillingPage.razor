@page "/billing"
@using Agiliz.Core.Billing
@using Agiliz.Core.Models
@using Agiliz.Core.Integrations
@using Agiliz.Wizard.Components.Atoms
@using System.Globalization
@inject Agiliz.Wizard.Services.RuntimeApiClient Runtime
@inject Agiliz.Wizard.Services.BotIntegrationService Integrations
@inject Agiliz.Wizard.Services.CostSettings Costs
@inject Agiliz.Core.Plans.PlanStore Plans
@inject Agiliz.Wizard.Services.AllowanceService Allowance

<div class="page-header">
    <div>
        <div class="page-title">Financeiro & Faturamento</div>
        <div class="page-sub">Custo de LLM e ferramentas por cliente, gravado pelo Runtime no Postgres</div>
    </div>
    <div style="display: flex; gap: 8px;">
        @foreach (var (key, label) in Periods)
        {
            <AgilizButton Variant="@(key == _period ? "primary" : "ghost")" Small="true" OnClick="() => ChangePeriod(key)">@label</AgilizButton>
        }
    </div>
</div>

<div class="wizard-content">

    @if (_error is not null)
    {
        <div class="form-card" style="color: var(--red, #e5484d); margin-bottom: 20px;">
            Não foi possível carregar o billing do Runtime: @_error
        </div>
    }

    <div style="display: flex; gap: 20px; margin-bottom: 30px;">
        <div class="form-card" style="flex: 1; text-align: center;">
            <div style="color: var(--text-3); font-size: 13px; font-weight: 600;">CUSTO TOTAL (TCO)</div>
            <div style="font-size: 32px; font-weight: 700; color: var(--lilac); margin-top: 8px;">
                $ @Report.TotalUsd.ToString("0.000")
            </div>
        </div>
        <div class="form-card" style="flex: 1; text-align: center;">
            <div style="color: var(--text-3); font-size: 13px; font-weight: 600;">CUSTO LLM (TOKENS)</div>
            <div style="font-size: 32px; font-weight: 700; color: var(--teal); margin-top: 8px;">
                $ @Report.Tenants.Sum(t => t.LlmUsd).ToString("0.000")
            </div>
        </div>
        <div class="form-card" style="flex: 1; text-align: center;">
            <div style="color: var(--text-3); font-size: 13px; font-weight: 600;">CUSTO FERRAMENTAS</div>
            <div style="font-size: 32px; font-weight: 700; color: var(--yellow); margin-top: 8px;">
                $ @Report.Tenants.Sum(t => t.ToolsUsd).ToString("0.000")
            </div>
        </div>
    </div>

    <div class="form-card" style="margin-bottom: 30px;">
        <h4 style="margin-bottom: 20px; font-family: var(--mono); color: var(--text-2);">Por cliente (R$)</h4>
        @if (Rows.Count == 0)
        {
            <div style="color: var(--text-3); padding: 12px 0;">Nenhum cliente com custo ou bot cadastrado.</div>
        }
        else
        {
            <table class="billing-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th style="text-align: right;">Preço/mês</th>
                        <th style="text-align: right;">Franquia (mês atual)</th>
                        <th style="text-align: right;">Uso no período</th>
                        <th style="text-align: right;">Fixos/mês</th>
                        <th style="text-align: right;">Margem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        var margin = Margin(row);
                        <tr>
                            <td>
                                <AgilizBadge Text="@row.TenantId" ColorType="groq" />
                                @if (row.Breakdown.Length > 0)
                                {
                                    <div style="color: var(--text-3); font-size: 12px; margin-top: 6px;">@row.Breakdown</div>
                                }
                            </td>
                            <td style="text-align: right; font-family: var(--mono);">
                                @(row.PriceBrl is { } p ? Brl(p) : "—")
                                @if (row.PlanName is not null)
                                {
                                    <div style="color: var(--text-3); font-size: 11px;">@row.PlanName</div>
                                }
                            </td>
                            <td style="text-align: right; font-family: var(--mono); color: @(row.Allowance?.Level switch { Agiliz.Core.Plans.AllowanceLevel.Exceeded => "var(--red)", Agiliz.Core.Plans.AllowanceLevel.Warning => "var(--yellow)", _ => "var(--text)" });">
                                @if (row.Allowance is { Level: not Agiliz.Core.Plans.AllowanceLevel.NoPlan } a)
                                {
                                    @($"{a.Contacts}/{a.Allowance}")
                                    @if (a.OverageRevenueBrl is > 0)
                                    {
                                        <div style="font-size: 11px;">+@Brl(a.OverageRevenueBrl.Value) excedente</div>
                                    }
                                }
                                else
                                {
                                    <span style="color: var(--text-3);">—</span>
                                }
                            </td>
                            <td style="text-align: right; font-family: var(--mono);">@(_error is null ? Brl(row.UsageBrl) : "—")</td>
                            <td style="text-align: right; font-family: var(--mono);">@(MonthlyView ? Brl(row.FixedBrl) : "—")</td>
                            <td style="text-align: right; font-family: var(--mono); color: @(margin is < 0 ? "var(--red)" : "var(--text)");">
                                @if (margin is { } m)
                                {
                                    @Brl(m) <span style="color: var(--text-3);">(@((m / row.PriceBrl!.Value).ToString("P0", PtBr)))</span>
                                }
                                else
                                {
                                    <span style="color: var(--text-3);">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <div style="color: var(--text-3); font-size: 12px; margin-top: 12px;">
            Câmbio R$ @Costs.UsdToBrl.ToString("0.00", PtBr) por US$@(Costs.ConfiguredUsdToBrl is null ? " (padrão; defina Billing:UsdToBrl)" : "").
            Fixos = Billing:FixedMonthlyBrl por integração ligada. Preço = negociado ou plano + adicionais ligados.
            Margem = preço + excedente − uso − fixos; aparece com preço definido e nos filtros mensais.
        </div>
    </div>

    <div class="form-card">
        <h4 style="margin-bottom: 20px; font-family: var(--mono); color: var(--text-2);">
            Extrato de Lançamentos
            @if (Report.EntryCount > Report.Entries.Count)
            {
                <span style="color: var(--text-3); font-size: 12px;">(últimos @Report.Entries.Count de @Report.EntryCount)</span>
            }
        </h4>

        @if (_loading)
        {
            <div style="text-align: center; color: var(--text-3); padding: 40px 0;">carregando...</div>
        }
        else if (Report.Entries.Count == 0)
        {
            <div style="text-align: center; color: var(--text-3); padding: 40px 0;">
                Nenhum custo registrado no período. Comece a conversar com os bots!
            </div>
        }
        else
        {
            <table class="billing-table">
                <thead>
                    <tr>
                        <th>Data/Hora</th>
                        <th>Tenant</th>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th style="text-align: right;">Custo (USD)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Report.Entries)
                    {
                        <tr>
                            <td>@entry.Timestamp.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td><AgilizBadge Text="@entry.TenantId" ColorType="groq" /></td>
                            <td>
                                @if (entry.Type == CostType.TokensLLM)
                                {
                                    <AgilizBadge Text="LLM" ColorType="flow" />
                                }
                                else if (entry.Type == CostType.ToolExecution)
                                {
                                    <AgilizBadge Text="Tool" ColorType="claude" />
                                }
                                else
                                {
                                    <AgilizBadge Text="@entry.Type.ToString()" ColorType="groq" />
                                }
                            </td>
                            <td class="desc-cell">@entry.Description</td>
                            <td style="text-align: right; font-family: var(--mono); color: var(--text);">
                                $@entry.AmountUsd.ToString("0.00000")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private static readonly (string Key, string Label)[] Periods =
    [
        ("month", "Este mês"),
        ("30d", "Últimos 30 dias"),
        ("all", "Tudo")
    ];

    private static readonly CultureInfo PtBr = new("pt-BR");

    private string _period = "month";
    private bool _loading = true;
    private string? _error;
    private BillingReport Report = new();
    private List<ClientRow> Rows = [];

    /// <summary>Preço e custos fixos são mensais: só comparam com o uso nos filtros de um mês.</summary>
    private bool MonthlyView => _period != "all";

    private sealed record ClientRow(string TenantId, decimal? PriceBrl, decimal UsageBrl, decimal FixedBrl, string Breakdown,
        string? PlanName = null, Agiliz.Core.Plans.AllowanceStatus? Allowance = null);

    private Agiliz.Wizard.Services.AllowanceReport? _allowance;

    private static string Brl(decimal value) => value.ToString("C2", PtBr);

    /// <summary>Sem o billing do Runtime o custo de uso é desconhecido: margem não aparece (não é 100%).</summary>
    private decimal? Margin(ClientRow row) =>
        _error is null && MonthlyView && row.PriceBrl is { } price && price > 0
            ? price + (row.Allowance?.OverageRevenueBrl ?? 0m) - row.UsageBrl - row.FixedBrl
            : null;

    private void BuildRows()
    {
        var bots = Integrations.Bots();
        var tenants = Report.Tenants.ToDictionary(t => t.TenantId, StringComparer.OrdinalIgnoreCase);

        Rows = bots.Keys.Union(tenants.Keys, StringComparer.OrdinalIgnoreCase)
            .Select(id =>
            {
                var bot = bots.GetValueOrDefault(id);
                var plan = Plans.Get(bot?.PlanId);
                var summary = tenants.GetValueOrDefault(id);
                var breakdown = string.Join(" · ", (summary?.ByIntegration ?? [])
                    .Select(i => $"{IntegrationCatalog.Find(i.IntegrationId)?.Name ?? "sem integração"} {Brl(Costs.ToBrl(i.TotalUsd))}"));
                return new ClientRow(
                    id,
                    bot is null ? null : Agiliz.Core.Plans.BotPricing.MonthlyPriceBrl(bot, plan),
                    Costs.ToBrl(summary?.TotalUsd ?? 0m),
                    bot is null ? 0m : Costs.FixedMonthlyBrl(bot),
                    breakdown,
                    plan?.Name,
                    _allowance?.For(id));
            })
            .OrderByDescending(r => r.UsageBrl)
            .ThenBy(r => r.TenantId, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task ChangePeriod(string period)
    {
        _period = period;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var now = DateTimeOffset.Now;
            DateTimeOffset? from = _period switch
            {
                "month" => new DateTimeOffset(now.Year, now.Month, 1, 0, 0, 0, now.Offset),
                "30d" => now.AddDays(-30),
                _ => null
            };
            Report = await Runtime.GetBillingAsync(from, to: null);
            _allowance ??= await Allowance.GetAsync();
            if (_allowance.Error is not null) _allowance = null;
            BuildRows();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = ex.Message;
            Report = new();
            BuildRows();
        }
        finally
        {
            _loading = false;
        }
    }
}
