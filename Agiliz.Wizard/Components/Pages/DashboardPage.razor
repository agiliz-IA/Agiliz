@page "/"
@using Agiliz.Core.Config
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject NavigationManager NavManager
@inject Agiliz.Wizard.Services.RuntimeApiClient Runtime
@inject Agiliz.Wizard.Services.AllowanceService Allowance
@inject Agiliz.Wizard.Services.DemoBotService Demo
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <div class="page-title">bots ativos</div>
        <div class="page-sub">gerencie e teste seus bots WhatsApp</div>
    </div>
    <div style="display: flex; gap: 8px;">
    @if (!Demo.Exists)
    {
        <AgilizButton Variant="ghost" OnClick="CreateDemoAsync">Criar bot de demonstração</AgilizButton>
    }
    <AgilizButton Variant="primary" OnClick='() => NavManager.NavigateTo("/create")'>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="2" x2="8" y2="14" /><line x1="2" y1="8" x2="14" y2="8" />
        </svg>
        Novo Bot
    </AgilizButton>
    </div>
</div>

@if (_allowance?.Alerts.Any() == true)
{
    <div style="margin: 16px 28px 0; padding: 12px 16px; border: 1px solid var(--yellow); border-radius: var(--radius-lg); color: var(--yellow); font-size: 13px;">
        Franquia do mês:
        @foreach (var a in _allowance.Alerts)
        {
            <span style="margin-left: 8px;">@a.TenantId @a.Contacts/@a.Allowance (@a.Ratio.ToString("P0"))@(a.Level == Agiliz.Core.Plans.AllowanceLevel.Exceeded ? " — excedida" : "")</span>
        }
        <span style="color: var(--text-3); margin-left: 8px;">O atendimento continua normalmente.</span>
    </div>
}

<div class="bots-grid">
    @if (_bots == null)
    {
        <div style="color:var(--text-3);font-size:13px;padding:8px;">carregando...</div>
    }
    else if (!_bots.Any())
    {
        <div class="empty-state" style="grid-column:1/-1">
            <div class="empty-state-icon">&gt;_</div>
            <p>Nenhum bot configurado ainda.</p>
            <AgilizButton Variant="primary" OnClick='() => NavManager.NavigateTo("/create")'>Criar primeiro bot</AgilizButton>
        </div>
    }
    else
    {
        @foreach (var b in _bots)
        {
            <div class="bot-card" @key="b.TenantId">
                <div class="bot-card-id">@b.TenantId</div>
                <div class="bot-card-meta">
                    <AgilizBadge Text="@b.Provider" ColorType="@(b.Provider.ToLower())" />
                    <span class="bot-card-flows">@b.FlowCount flow@(b.FlowCount != 1 ? "s" : "")</span>
                </div>
                <div class="bot-card-number">@b.WhatsAppNumber</div>
                @if (_allowance?.For(b.TenantId) is { } usage)
                {
                    <div style="font-size: 12px; margin-top: 6px; color: @(usage.Level switch { Agiliz.Core.Plans.AllowanceLevel.Exceeded => "var(--red)", Agiliz.Core.Plans.AllowanceLevel.Warning => "var(--yellow)", _ => "var(--text-3)" });">
                        @if (usage.Level == Agiliz.Core.Plans.AllowanceLevel.NoPlan)
                        {
                            <span>sem plano · @usage.Contacts contatos no mês</span>
                        }
                        else
                        {
                            <span>@usage.PlanName · @usage.Contacts/@usage.Allowance contatos (@usage.Ratio.ToString("P0"))</span>
                        }
                    </div>
                }
                <div class="bot-card-actions">
                    <AgilizButton Variant="teal" Small="true" OnClick='() => NavManager.NavigateTo($"/test/{b.TenantId}")'>▶ Testar</AgilizButton>
                    <AgilizButton Variant="ghost" Small="true" OnClick='() => NavManager.NavigateTo($"/edit/{b.TenantId}")'>Editar</AgilizButton>
                    <AgilizButton Variant="ghost" Small="true" OnClick='() => NavManager.NavigateTo($"/bots/{b.TenantId}/integrations")'>Integrações</AgilizButton>
                    <AgilizButton Variant="danger" Small="true" OnClick='() => DeleteBot(b.TenantId)'>Deletar</AgilizButton>
                </div>
            </div>
        }
    }
</div>

@code {
    private string _configsDir = "";
    private List<BotViewModel>? _bots;
    private Agiliz.Wizard.Services.AllowanceReport? _allowance;

    protected override async Task OnInitializedAsync()
    {
        _configsDir = BotConfigLoader.ResolveConfigsDir(Config);
        LoadBots();
        _allowance = await Allowance.GetAsync();
        // Sem Runtime não sabemos o uso: melhor não mostrar "0 contatos".
        if (_allowance.Error is not null) _allowance = null;
    }

    private void LoadBots()
    {
        var tenants = BotConfigLoader.ListTenants(_configsDir);
        _bots = tenants.Select(id =>
        {
            try
            {
                var c = BotConfigLoader.Load(_configsDir, id);
                return new BotViewModel(c.TenantId, c.WhatsAppNumber, c.Llm.Provider.ToString(), c.Flows.Count);
            }
            catch
            {
                return new BotViewModel(id, "erro", "-", 0);
            }
        }).ToList();
    }

    private async Task CreateDemoAsync()
    {
        var number = await JS.InvokeAsync<string?>("prompt", "Número do chip da demonstração (com DDD):");
        if (string.IsNullOrWhiteSpace(number)) return;
        var sellers = await JS.InvokeAsync<string?>("prompt", "WhatsApp dos vendedores que entram no portal (separe por vírgula):");
        if (string.IsNullOrWhiteSpace(sellers)) return;

        var outcome = await Demo.CreateAsync(number, sellers.Split(',', ';'));
        if (!outcome.Ok)
        {
            await JS.InvokeVoidAsync("toast", outcome.Error, "error");
            return;
        }
        LoadBots();
        await JS.InvokeVoidAsync("toast", "Bot de demonstração criado. Falta conectar o número e informar o ID da agenda de exemplo.", "success");
        NavManager.NavigateTo($"/bots/{Agiliz.Wizard.Services.DemoBotService.TenantId}/integrations");
    }

    private async Task DeleteBot(string id)
    {
        if (!BotConfigLoader.Delete(_configsDir, id)) return;
        LoadBots();

        // O Runtime só para de atender o número depois de recarregar.
        var reload = await Runtime.ReloadAsync();
        if (reload.Ok)
            await JS.InvokeVoidAsync("toast", $"Bot {id} removido e desligado no Runtime.", "success");
        else
            await JS.InvokeVoidAsync("toast", $"Bot {id} removido, mas o Runtime não recarregou: {reload.Error}", "error");
    }

    private record BotViewModel(string TenantId, string WhatsAppNumber, string Provider, int FlowCount);
}
