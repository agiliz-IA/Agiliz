@page "/bots/{TenantId}/integrations"
@using Agiliz.Core.Integrations
@using Agiliz.Wizard.Services
@inject BotIntegrationService Integrations
@inject Agiliz.Core.Plans.PlanStore Plans
@inject RuntimeApiClient Runtime
@inject NavigationManager NavManager
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <div class="page-title">integrações · @TenantId</div>
        <div class="page-sub">Ligue o que este cliente contratou. A mudança vale na próxima mensagem dele.</div>
    </div>
    <AgilizButton Variant="ghost" Small="true" OnClick='() => NavManager.NavigateTo("/")'>← Bots</AgilizButton>
</div>

<div class="wizard-content">
    @if (_view is null)
    {
        <div class="form-card" style="color: var(--text-3);">Bot não encontrado.</div>
    }
    else
    {
        @foreach (var warning in _view.Warnings)
        {
            <div class="form-card" style="border-color: var(--yellow); color: var(--yellow); margin-bottom: 16px;">@warning</div>
        }

        <div class="form-card" style="margin-bottom: 20px;">
            <div style="display: flex; align-items: end; gap: 12px; flex-wrap: wrap;">
                <div style="flex: 1; min-width: 220px;">
                    <div style="color: var(--text-2); font-size: 13px; margin-bottom: 6px;">Plano</div>
                    <select class="integration-input" value="@(_planId ?? "")" @onchange="e => _planId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                        <option value="">Sem plano</option>
                        @foreach (var p in _plans)
                        {
                            <option value="@p.Id">@p.Name — @p.MonthlyPriceBrl.ToString("C0", PtBr)/mês · @p.ConversationAllowance contatos@(p.Active ? "" : " (inativo)")</option>
                        }
                    </select>
                </div>
                <AgilizButton Variant="primary" Small="true" OnClick="SavePlanAsync">Salvar plano</AgilizButton>
            </div>
            <div style="display: flex; align-items: end; gap: 12px; flex-wrap: wrap; margin-top: 14px;">
                <div style="flex: 1; min-width: 220px;">
                    <div style="color: var(--text-2); font-size: 13px; margin-bottom: 6px;">Preço negociado (R$/mês, opcional)</div>
                    <input class="integration-input" type="number" min="0" step="0.01" placeholder="vazio = preço do plano + adicionais" @bind="_price" />
                </div>
                <AgilizButton Variant="ghost" Small="true" OnClick="SavePriceAsync">Salvar preço</AgilizButton>
            </div>
            <div style="color: var(--text-3); font-size: 12px; margin-top: 8px;">
                Preço que vale hoje: @(_effectivePrice is { } ep ? ep.ToString("C2", PtBr) : "—")
                @(_view.MonthlyPriceBrl is not null ? "(negociado)" : _plan is not null ? "(plano + adicionais ligados)" : "")
            </div>
            @foreach (var outside in _outsidePlan)
            {
                <div style="color: var(--yellow); font-size: 12px; margin-top: 4px;">@outside.Name está ligada mas não faz parte do plano nem tem preço de adicional.</div>
            }
        </div>

        <div class="form-card" style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
                <div style="font-weight: 600; color: var(--text);">Portal do cliente</div>
                <a href="/portal/" target="_blank" rel="noopener" style="font-size: 13px; color: var(--lilac);">Abrir portal ↗</a>
            </div>
            <div style="color: var(--text-3); font-size: 12px; margin-top: 4px;">
                Quem está aqui entra pela tela de entrada (/entrar) com um código no WhatsApp e só vê este bot. Para convidar por e-mail ou dar acesso a vários bots, use <a href="/acessos" style="color: var(--lilac);">Acessos</a>.
            </div>
            <div style="display: grid; gap: 10px; margin-top: 12px;">
                <label style="display: grid; gap: 4px;">
                    <span style="color: var(--text-2); font-size: 13px;">Nome no portal</span>
                    <input class="integration-input" @bind="_displayName" placeholder="ex.: Clínica Sorriso" />
                </label>
                <label style="display: grid; gap: 4px;">
                    <span style="color: var(--text-2); font-size: 13px;">WhatsApp com acesso (um por linha)</span>
                    <textarea class="integration-input" rows="3" @bind="_portalPhones" placeholder="21 99999-9999"></textarea>
                </label>
                <label style="display: grid; gap: 4px;">
                    <span style="color: var(--text-2); font-size: 13px;">Responder só a estes números (um por linha; vazio = todos)</span>
                    <textarea class="integration-input" rows="2" @bind="_respondOnlyTo" placeholder="Use ao demonstrar num número pessoal"></textarea>
                </label>
                <label style="display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--text-2);">
                    <input type="checkbox" @bind="_isDemo" />
                    Bot de demonstração (limpo toda madrugada; telefones mascarados no portal)
                </label>
            </div>
            <div style="margin-top: 12px;">
                <AgilizButton Variant="primary" Small="true" OnClick="SavePortalAsync">Salvar portal</AgilizButton>
            </div>
        </div>

        @foreach (var state in _view.Integrations.OrderBy(i => i.Definition.Status).ThenBy(i => i.Definition.AlwaysOn ? 0 : 1))
        {
            var def = state.Definition;
            var draft = _drafts[def.Id];
            var editable = def.Status == IntegrationStatus.Available;

            <div class="form-card" style="margin-bottom: 16px; @(editable ? "" : "opacity: 0.7;")" @key="def.Id">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                    <div style="font-weight: 600; color: var(--text);">@def.Name</div>
                    @if (def.AlwaysOn)
                    {
                        <AgilizBadge Text="sempre ligada" ColorType="claude" />
                    }
                    else if (def.Status == IntegrationStatus.OnRequest)
                    {
                        <AgilizBadge Text="sob consulta" ColorType="groq" />
                    }
                    else if (def.Status == IntegrationStatus.ComingSoon)
                    {
                        <AgilizBadge Text="em breve" ColorType="groq" />
                    }
                    else if (state.Enabled)
                    {
                        <AgilizBadge Text="ligada" ColorType="flow" />
                    }
                    else
                    {
                        <span style="font-size: 11px; font-family: var(--mono); color: var(--text-3);">desligada</span>
                    }
                </div>
                <div style="color: var(--text-2); font-size: 13px; margin-top: 6px;">@def.Description</div>
                <div style="color: var(--text-3); font-size: 12px; margin-top: 4px;">Custo: @def.CostNote</div>
                @if (_plan is not null && !def.AlwaysOn && editable)
                {
                    <div style="font-size: 12px; margin-top: 4px; color: var(--text-2);">
                        @(_plan.Includes(def.Id) ? $"Incluída no plano {_plan.Name}." : _plan.AddOnPrice(def.Id) is { } addOn ? $"Adicional: {addOn.ToString("C2", PtBr)}/mês." : $"Não faz parte do plano {_plan.Name}.")
                    </div>
                }

                @if (state.BlockedReason is not null && editable)
                {
                    <div style="color: var(--yellow); font-size: 12px; margin-top: 8px;">@state.BlockedReason</div>
                }

                @if (editable && def.Fields.Count > 0)
                {
                    <div style="margin-top: 14px; display: grid; gap: 10px;">
                        @foreach (var field in def.Fields)
                        {
                            <label style="display: grid; gap: 4px;">
                                <span style="color: var(--text-2); font-size: 13px;">@field.Label@(field.Required ? " *" : "")</span>
                                <input class="integration-input" placeholder="@field.Placeholder"
                                       value="@draft.Fields.GetValueOrDefault(field.Key)"
                                       @onchange="e => draft.Fields[field.Key] = e.Value?.ToString() ?? string.Empty" />
                                @if (field.Help is not null)
                                {
                                    <span style="color: var(--text-3); font-size: 12px;">@field.Help</span>
                                }
                            </label>
                        }
                    </div>
                }

                @if (def.ClientSteps.Count > 0)
                {
                    <div style="margin-top: 14px;">
                        <div style="color: var(--text-2); font-size: 13px; margin-bottom: 6px;">Passos do cliente</div>
                        @foreach (var step in def.ClientSteps)
                        {
                            <label style="display: flex; gap: 8px; align-items: flex-start; font-size: 13px; color: var(--text-2); margin-bottom: 4px;">
                                <input type="checkbox" disabled="@(!editable)" checked="@draft.Steps.Contains(step.Id)"
                                       @onchange="e => ToggleStep(draft, step.Id, e.Value is true)" />
                                <span>@step.Text</span>
                            </label>
                        }
                        @if (def.Id == IntegrationCatalog.GoogleCalendar && _info?.GoogleServiceAccountEmail is { } account)
                        {
                            <div style="font-size: 12px; color: var(--text-3); margin-top: 4px;">
                                Conta de serviço: <span style="font-family: var(--mono); color: var(--text);">@account</span>
                            </div>
                        }
                    </div>
                }

                @if (editable)
                {
                    <div style="display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap;">
                        @if (!def.AlwaysOn)
                        {
                            <AgilizButton Variant="@(state.Enabled ? "danger" : "teal")" Small="true" Disabled="@(draft.Busy || (!state.Enabled && state.BlockedReason is not null))"
                                          OnClick="() => ToggleAsync(def.Id, !state.Enabled)">
                                @(state.Enabled ? "Desligar" : "Ligar")
                            </AgilizButton>
                        }
                        @if (def.Fields.Count > 0 || def.ClientSteps.Count > 0)
                        {
                            <AgilizButton Variant="ghost" Small="true" Disabled="draft.Busy" OnClick="() => SaveAsync(def.Id, state.Enabled)">Salvar</AgilizButton>
                        }
                        @if (def.Id == IntegrationCatalog.WhatsApp)
                        {
                            <AgilizButton Variant="ghost" Small="true" Disabled="draft.Busy" OnClick="PairingAsync">Gerar código de conexão</AgilizButton>
                        }
                        @if (def.Testable)
                        {
                            <AgilizButton Variant="ghost" Small="true" Disabled="draft.Busy" OnClick="() => TestAsync(def.Id)">Testar conexão</AgilizButton>
                        }
                    </div>
                    @if (def.Id == IntegrationCatalog.WhatsApp && _qrCode is not null)
                    {
                        <div style="margin-top: 10px; display: grid; gap: 6px; justify-items: start;">
                            <img src="@_qrCode" alt="QR code para conectar o WhatsApp" style="width: 240px; height: 240px; background: #fff; padding: 8px; border-radius: 8px;" />
                            <span style="font-size: 12px; color: var(--text-3);">O QR muda a cada ~40 s. Se expirar, gere de novo.</span>
                        </div>
                    }
                    @if (draft.TestMessage is not null)
                    {
                        <div style="margin-top: 10px; font-size: 13px; color: @(draft.TestOk ? "var(--teal)" : "var(--red)");">
                            @(draft.TestOk ? "✓" : "✗") @draft.TestMessage
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<style>
    .integration-input {
        width: 100%;
        background: var(--surface-2);
        border: 1px solid var(--border-2);
        border-radius: var(--radius);
        color: var(--text);
        padding: 8px 10px;
        font-size: 13px;
    }
</style>

@code {
    [Parameter] public string TenantId { get; set; } = "";

    private static readonly System.Globalization.CultureInfo PtBr = new("pt-BR");

    private BotIntegrationsView? _view;
    private IReadOnlyList<Agiliz.Core.Plans.Plan> _plans = [];
    private Agiliz.Core.Plans.Plan? _plan;
    private string? _planId;
    private decimal? _effectivePrice;
    private string? _displayName;
    private string _portalPhones = "";
    private bool _isDemo;
    private string _respondOnlyTo = "";
    private string? _qrCode;
    private IReadOnlyList<IntegrationDefinition> _outsidePlan = [];
    private IntegrationServerInfo? _info;
    private decimal? _price;
    private readonly Dictionary<string, Draft> _drafts = new(StringComparer.OrdinalIgnoreCase);

    private sealed class Draft
    {
        public Dictionary<string, string> Fields { get; } = new(StringComparer.OrdinalIgnoreCase);
        public HashSet<string> Steps { get; } = new(StringComparer.OrdinalIgnoreCase);
        public string? TestMessage { get; set; }
        public bool TestOk { get; set; }
        public bool Busy { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        Load();
        _info = await Runtime.GetIntegrationInfoAsync();
    }

    private void Load()
    {
        _view = Integrations.Get(TenantId);
        if (_view is null) return;
        _price = _view.MonthlyPriceBrl;
        _plans = Plans.List();
        _plan = Plans.Get(_view.PlanId);
        _planId = _view.PlanId;
        var config = Integrations.Bots().GetValueOrDefault(TenantId);
        _effectivePrice = config is null ? null : Agiliz.Core.Plans.BotPricing.MonthlyPriceBrl(config, _plan);
        _displayName = config?.DisplayName;
        _portalPhones = string.Join("\n", config?.PortalPhones ?? []);
        _isDemo = config?.IsDemo ?? false;
        _respondOnlyTo = string.Join("\n", config?.RespondOnlyTo ?? []);
        _outsidePlan = config is not null && _plan is not null ? Agiliz.Core.Plans.BotPricing.OutsidePlan(config, _plan) : [];

        foreach (var state in _view.Integrations)
        {
            var draft = _drafts.TryGetValue(state.Definition.Id, out var existing) ? existing : _drafts[state.Definition.Id] = new Draft();
            draft.Fields.Clear();
            foreach (var (key, value) in state.Fields) draft.Fields[key] = value;
            draft.Steps.Clear();
            draft.Steps.UnionWith(state.CompletedSteps);
        }
    }

    private static void ToggleStep(Draft draft, string stepId, bool done)
    {
        if (done) draft.Steps.Add(stepId); else draft.Steps.Remove(stepId);
    }

    private Task ToggleAsync(string integrationId, bool enable) => SaveAsync(integrationId, enable);

    private async Task SaveAsync(string integrationId, bool enabled)
    {
        var draft = _drafts[integrationId];
        draft.Busy = true;
        try
        {
            var outcome = await Integrations.UpdateAsync(TenantId, integrationId, new IntegrationUpdate
            {
                Enabled = enabled,
                Fields = new Dictionary<string, string>(draft.Fields),
                CompletedSteps = draft.Steps.ToList()
            });

            if (!outcome.Ok)
                await JS.InvokeVoidAsync("toast", outcome.Error, "error");
            else if (!outcome.RuntimeReloaded)
                await JS.InvokeVoidAsync("toast", $"Salvo, mas o Runtime não recarregou: {outcome.RuntimeError}", "error");
            else
                await JS.InvokeVoidAsync("toast", "Salvo e ativo no Runtime.", "success");

            Load();
        }
        finally
        {
            draft.Busy = false;
        }
    }

    private async Task TestAsync(string integrationId)
    {
        var draft = _drafts[integrationId];
        draft.Busy = true;
        draft.TestMessage = "testando...";
        draft.TestOk = true;
        StateHasChanged();
        try
        {
            var result = await Runtime.TestIntegrationAsync(integrationId, TenantId, new Dictionary<string, string>(draft.Fields));
            draft.TestOk = result.Ok;
            draft.TestMessage = result.Message;
        }
        finally
        {
            draft.Busy = false;
        }
    }

    private async Task SavePortalAsync()
    {
        var phones = _portalPhones.Split(['\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var onlyTo = _respondOnlyTo.Split(['\n', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var outcome = await Integrations.SetPortalSettingsAsync(TenantId, _displayName, phones, _isDemo, onlyTo);
        await JS.InvokeVoidAsync("toast", outcome.Ok ? "Portal salvo." : outcome.Error, outcome.Ok ? "success" : "error");
        Load();
    }

    /// <summary>Código de pareamento da Evolution: digitar no WhatsApp do número do bot (Aparelhos conectados).</summary>
    private async Task PairingAsync()
    {
        var draft = _drafts[IntegrationCatalog.WhatsApp];
        draft.Busy = true;
        draft.TestMessage = "gerando código...";
        draft.TestOk = true;
        StateHasChanged();
        try
        {
            var result = await Runtime.RequestPairingAsync(TenantId);
            draft.TestOk = result.Ok;
            _qrCode = result.QrCodeDataUrl;
            draft.TestMessage = result.Ok && result.PairingCode is not null
                ? $"Código: {result.PairingCode} — no WhatsApp do número do bot: Aparelhos conectados › Conectar um aparelho › Conectar com número de telefone."
                : result.Message;
        }
        finally
        {
            draft.Busy = false;
        }
    }

    private async Task SavePlanAsync()
    {
        var outcome = await Integrations.SetPlanAsync(TenantId, _planId, Plans);
        await JS.InvokeVoidAsync("toast", outcome.Ok ? "Plano salvo." : outcome.Error, outcome.Ok ? "success" : "error");
        Load();
    }

    private async Task SavePriceAsync()
    {
        var outcome = await Integrations.SetPriceAsync(TenantId, _price);
        await JS.InvokeVoidAsync("toast", outcome.Ok ? "Preço salvo." : outcome.Error, outcome.Ok ? "success" : "error");
        Load();
    }
}
