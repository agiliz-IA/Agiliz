@page "/integrations"
@using System.Globalization
@using Agiliz.Core.Billing
@using Agiliz.Core.Integrations
@using Agiliz.Wizard.Services
@inject BotIntegrationService Integrations
@inject RuntimeApiClient Runtime
@inject CostSettings Costs
@inject NavigationManager NavManager

<div class="page-header">
    <div>
        <div class="page-title">Integrações</div>
        <div class="page-sub">O que vendemos como serviço, quem usa e quanto custou neste mês</div>
    </div>
</div>

<div class="wizard-content">
    @if (_costError is not null)
    {
        <div class="form-card" style="color: var(--text-3); margin-bottom: 16px;">Custos indisponíveis (Runtime não respondeu): @_costError</div>
    }

    <div class="form-card">
        <table class="int-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="text-align: left;">Integração</th>
                    <th style="text-align: left;">Estado</th>
                    <th style="text-align: left;">Clientes</th>
                    <th style="text-align: right;">Custo no mês</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usage in _usage)
                {
                    var def = usage.Definition;
                    <tr>
                        <td style="padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: top;">
                            <div style="font-weight: 600; color: var(--text);">@def.Name</div>
                            <div style="color: var(--text-2); font-size: 12px; margin-top: 4px;">@def.Description</div>
                            <div style="color: var(--text-3); font-size: 12px; margin-top: 4px;">@def.CostNote</div>
                        </td>
                        <td style="padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: top;">
                            <AgilizBadge Text="@StatusLabel(def)" ColorType="@(def.Status == IntegrationStatus.Available ? "flow" : "groq")" />
                        </td>
                        <td style="padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: top;">
                            @if (usage.Tenants.Count == 0)
                            {
                                <span style="color: var(--text-3); font-size: 12px;">nenhum</span>
                            }
                            @foreach (var tenant in usage.Tenants)
                            {
                                <span style="cursor: pointer; margin: 0 4px 4px 0; display: inline-block;" @onclick='() => NavManager.NavigateTo($"/bots/{tenant}/integrations")'>
                                    <AgilizBadge Text="@tenant" ColorType="groq" />
                                </span>
                            }
                        </td>
                        <td style="padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: top; text-align: right; font-family: var(--mono);">
                            @MonthCost(def.Id)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="color: var(--text-3); font-size: 12px; margin-top: 12px;">
            Custos de uso convertidos a R$ @Costs.UsdToBrl.ToString("0.00", PtBr) por US$@(Costs.ConfiguredUsdToBrl is null ? " (padrão; defina Billing:UsdToBrl)" : "").
            Integração nova exige código: este catálogo só mostra o que existe.
        </div>
    </div>
</div>

<style>
    .int-table th {
        padding: 12px 16px;
        border-bottom: 2px solid var(--border);
        color: var(--text-3);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }
</style>

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");

    private IReadOnlyList<IntegrationUsage> _usage = [];
    private BillingReport? _month;
    private string? _costError;

    protected override async Task OnInitializedAsync()
    {
        _usage = Integrations.Usage();
        try
        {
            var now = DateTimeOffset.Now;
            _month = await Runtime.GetBillingAsync(new DateTimeOffset(now.Year, now.Month, 1, 0, 0, 0, now.Offset), to: null, limit: 1);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _costError = ex.Message;
        }
    }

    private string MonthCost(string integrationId)
    {
        if (_month is null) return "—";
        var usd = _month.Integrations.FirstOrDefault(i => string.Equals(i.IntegrationId, integrationId, StringComparison.OrdinalIgnoreCase))?.TotalUsd ?? 0m;
        return Costs.ToBrl(usd).ToString("C2", PtBr);
    }

    private static string StatusLabel(IntegrationDefinition def) => def.Status switch
    {
        IntegrationStatus.Available => def.AlwaysOn ? "sempre ligada" : "disponível",
        IntegrationStatus.OnRequest => "sob consulta",
        _ => "em breve"
    };
}
