# Copie este arquivo para .env e preencha com suas credenciais.
# O .env nunca deve ser commitado — ele já está no .gitignore.

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Anthropic Claude ─────────────────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Evolution API - Banco de Dados ────────────────────────────────────────────────────────────────
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://evolution:evolution@postgres:5432/evolution?schema=public'
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# ─── Evolution API - Redis Cache ──────────────────────────────────────────────────────────────────
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ─── Evolution API - Servidor ─────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8080
DEL_INSTANCE=false
CORS_ORIGIN=*
AUTHENTICATION_API_KEY=429683C4C977415CAAFCCE10F7D57E11

# ─── Agiliz Runtime - Evolution API Client ────────────────────────────────────────────────────────
EVOLUTION_API_TOKEN=your-token-here

# ─── Agiliz Runtime ↔ Painel ──────────────────────────────────────────────────
# Token que o painel usa para recarregar bots, ler o billing e operar o handoff no Runtime.
# Gere um valor aleatório (ex.: openssl rand -hex 32). Sem ele essas telas do painel ficam desligadas.
RUNTIME_ADMIN_TOKEN=

# ─── Financeiro do painel ─────────────────────────────────────────────────────
# Câmbio usado para mostrar custos em R$ (vazio = 5,50) e custo fixo por cliente/mês
# do WhatsApp não oficial (parte da hospedagem). Outras integrações: Billing__FixedMonthlyBrl__<id>.
BILLING_USD_TO_BRL=
BILLING_FIXED_WHATSAPP_BRL=

# ─── Portal do cliente ────────────────────────────────────────────────────────
# Número (instância da Evolution) que envia o código de acesso quando o número do bot
# ainda não está conectado — por exemplo, o número da demonstração ou o comercial.
PORTAL_SENDER_NUMBER=
# true em produção (portal atrás de HTTPS). Só use false para testar sem HTTPS.
PORTAL_SECURE_COOKIES=true

# Agiliz Wizard - protecao simples para piloto assistido
WIZARD_ADMIN_USER=admin
WIZARD_ADMIN_PASSWORD=troque-esta-senha

