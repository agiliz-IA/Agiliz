# ════════════════════════════════════════════════════════════════════════════
#  Agiliz — variáveis de ambiente
#  Copie este arquivo para .env (na mesma pasta) e preencha.
#  O .env NUNCA vai para o git (já está no .gitignore). Não mande por chat.
#
#  Legenda:  [OBRIGATÓRIO]  sem isso não sobe ou não responde
#            [RECOMENDADO]  sobe sem, mas uma parte importante fica desligada
#            [OPCIONAL]     pode deixar como está
# ════════════════════════════════════════════════════════════════════════════


# ─── 1. Inteligência artificial ─────────────────────────────────────────────

# [OBRIGATÓRIO] Groq: é a IA usada pelos bots, pela entrevista do "Novo bot"
# e pela transcrição de áudios. Tem plano gratuito.
# Onde pegar: https://console.groq.com/keys → "Create API Key" (começa com gsk_)
GROQ_API_KEY=

# [OPCIONAL] Anthropic (Claude): só é usada se você escolher "Claude" como
# provedor de um bot genérico. Bots de agendamento sempre usam Groq.
# Onde pegar: https://console.anthropic.com/settings/keys (começa com sk-ant-)
ANTHROPIC_API_KEY=


# ─── 2. WhatsApp (Evolution API, roda junto no Docker) ──────────────────────

# [OBRIGATÓRIO] Senha da Evolution API. Você mesmo inventa.
# É uma senha só: a Evolution exige e o Agiliz usa a mesma automaticamente.
# Gerar um valor aleatório:
#   Windows (PowerShell): -join ((48..57)+(65..90) | Get-Random -Count 32 | % {[char]$_})
#   Mac/Linux:            openssl rand -hex 16
AUTHENTICATION_API_KEY=troque-por-um-valor-aleatorio

# Configuração interna da Evolution. Não precisa mexer.
SERVER_URL=http://localhost:8080
DEL_INSTANCE=false
CORS_ORIGIN=*
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI='postgresql://evolution:evolution@postgres:5432/evolution?schema=public'
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/1
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false


# ─── 3. Banco de dados (Postgres) e Redis ───────────────────────────────────
# Nada para preencher: o docker-compose.yml já cria o Postgres (usuário e senha
# "evolution") e o Redis. O banco fica em um volume do Docker e sobrevive a
# reinícios. Do seu PC dá para acessar em localhost:5433 se precisar.


# ─── 4. Painel (Wizard) ─────────────────────────────────────────────────────

# [OBRIGATÓRIO] Login do painel admin (o navegador pede usuário e senha).
# Troque a senha, principalmente se for expor o painel na internet (ngrok).
WIZARD_ADMIN_USER=admin
WIZARD_ADMIN_PASSWORD=troque-esta-senha

# [OBRIGATÓRIO] Senha interna entre o painel e o motor (Runtime). Você inventa.
# Sem ela, Atendimentos, Financeiro, Portal e "ativar bot sem reiniciar" ficam desligados.
# Gere do mesmo jeito que o AUTHENTICATION_API_KEY (pode ser mais longo).
RUNTIME_ADMIN_TOKEN=


# ─── 5. Portal do cliente (/portal) ─────────────────────────────────────────

# [OPCIONAL] Número já conectado na Evolution que envia o código de login do portal
# quando o número do bot ainda não está conectado (ex.: o número comercial).
# Só dígitos, com DDI e DDD: 5511999999999
PORTAL_SENDER_NUMBER=

# [RECOMENDADO] true quando o painel está atrás de HTTPS (ngrok, Cloudflare, servidor).
# Se o login do portal ficar "voltando para a tela de código" em http://localhost,
# troque para false só para testar.
PORTAL_SECURE_COOKIES=true


# ─── 6. Financeiro do painel ────────────────────────────────────────────────

# [OPCIONAL] Cotação do dólar para mostrar custos em R$ (vazio = 5,50).
BILLING_USD_TO_BRL=
# [OPCIONAL] Custo fixo por cliente/mês do WhatsApp (parte da hospedagem), em R$.
BILLING_FIXED_WHATSAPP_BRL=


# ─── 7. Google Agenda ───────────────────────────────────────────────────────
# [RECOMENDADO] Não é variável de ambiente: é um ARQUIVO. Veja o README, seção "Google Agenda".
# Salve a chave da conta de serviço em:  configs/google_credentials.json
# Sem ele tudo sobe normalmente; só o bot não consegue marcar na agenda.


# ─── 8. E-mail (SMTP) ───────────────────────────────────────────────────────
# [OPCIONAL] Servidor de e-mail para os bots mandarem e-mails.
# Vazio = os e-mails só aparecem no log (modo simulado).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
